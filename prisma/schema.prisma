// ============================================================
// Te Reparo Manager — Prisma Schema (Next.js + SQLite)
// ============================================================
// Generado a partir de src/lib/types.ts
// Base de datos: SQLite local — configurada via .env DATABASE_URL
// Convencion: prisma/dev.db (relativo al directorio prisma/)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  VENDEDOR
}

enum EspecialidadOperario {
  ELECTRONICA
  INFORMATICA
  VENDEDOR
  ADMIN
}

enum TipoCategoria {
  PRODUCTO
  PIEZA
}

enum TipoServicio {
  ELECTRONICA
  INFORMATICA
}

enum EstadoServicio {
  PENDIENTE
  COMPLETADO
  ENTREGADO
  CANCELADO
}

enum TipoGarantia {
  PRODUCTO
  SERVICIO
}

enum EstadoGarantia {
  ACTIVA
  VENCIDA
  INVALIDADA
}

enum ResolucionReclamacion {
  REPARACION_SIN_COSTO
  REEMPLAZO
  RECHAZO
}

enum TipoMovimiento {
  INGRESO
  GASTO
  COMPRA
}

enum TipoDevolucion {
  PRODUCTO
  PIEZA
}

enum EstadoDevolucion {
  PENDIENTE_REVISION
  APROBADA
  RECHAZADA
}

enum UrgenciaPedido {
  BAJA
  MEDIA
  ALTA
}

enum EstadoPedido {
  PENDIENTE
  APROBADO
  RECHAZADO
  CONVERTIDO
}

enum TipoComisionEntry {
  SALE
  SERVICE
}

enum EstadoCommissionEntry {
  ACTIVE
  CANCELLED
}

enum EstadoOperatorPayment {
  PENDING
  PAID
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

enum TipoCliente {
  PERSONA_NATURAL
  EMPRESA
}

// ============================================================
// MODELOS
// ============================================================

model Usuario {
  id            String      @id @default(cuid())
  email         String      @unique
  password      String
  nombre        String
  rol           RolUsuario
  activo        Boolean      @default(true)
  telefono      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  talleres      UsuarioTaller[]
  ventas        Venta[]
  movimientos   Movimiento[]
  pedidos       PedidoInterno[]
  aprobaciones  PedidoInterno[]   @relation("Aprobador")
  garantias     Garantia[]
  devolucionesRevisadas Devolucion[] @relation("RevisorDevolucion")

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("usuarios")
}

model Taller {
  id            String       @id @default(cuid())
  nombre        String
  direccion     String
  telefono      String
  encargado     String?
  activo        Boolean       @default(true)
  rfc           String?
  razonSocial   String?
  ciudad        String?
  codigoPostal  String?
  limiteDescuento Float      @default(10)
  horarioApertura String?
  horarioCierre   String?
  metodosPago     String     @default("Efectivo,Tarjeta,Transferencia")
  garantiaProductoDias Int   @default(30)
  garantiaServicioDias Int   @default(90)
  plantillaGarantia  String?
  formatoTicket      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  usuarios      UsuarioTaller[]
  productos     Producto[]
  piezas        Pieza[]
  categorias    Categoria[]
  ventas        Venta[]
  servicios     Servicio[]
  movimientos   Movimiento[]
  pedidos       PedidoInterno[]
  gastos        Gasto[]
  compras       Compra[]
  devoluciones  Devolucion[]
  garantias     Garantia[]
  commissionEntries CommissionEntry[]
  operatorPayments  OperatorPayment[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("talleres")
}

model UsuarioTaller {
  id        String   @id @default(cuid())
  usuarioId String
  tallerId  String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  taller    Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, tallerId])
  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("usuario_taller")
}

// ============ OPERARIOS (sin login) ============

model Operario {
  id            String              @id @default(cuid())
  nombre        String
  telefono      String?
  especialidad  EspecialidadOperario
  activo        Boolean              @default(true)
  createdAt     DateTime            @default(now())

  servicios     Servicio[]
  ventas        Venta[]
  comisiones    CommissionEntry[]
  pagos         OperatorPayment[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("operarios")
}

// ============ CLIENTES ============

model Cliente {
  id              String   @id @default(cuid())
  nombre          String
  telefono        String?
  email           String?
  tipo            TipoCliente @default(PERSONA_NATURAL)
  rfc             String?
  direccion       String?
  esClienteGeneral Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  ventas          Venta[]
  servicios       Servicio[]
  garantias       Garantia[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("clientes")
}

// ============ CATEGORÍAS ============

model Categoria {
  id        String         @id @default(cuid())
  nombre    String
  tipo      TipoCategoria
  activa    Boolean        @default(true)
  tallerId  String
  taller    Taller         @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  productos Producto[]
  piezas    Pieza[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("categorias")
}

// ============ INVENTARIO DUAL ============

model Producto {
  id              String   @id @default(cuid())
  sku             String
  codigoBarras    String   @unique
  nombre          String
  descripcion     String?
  precioCosto     Float
  precioVenta     Float
  stock           Int      @default(0)
  stockMinimo     Int      @default(5)
  garantiaDias    Int      @default(30)
  categoriaId     String?
  tallerId        String
  activo          Boolean  @default(true)
  operatorCommissionType  String?
  operatorCommissionValue Float?
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  categoria       Categoria? @relation(fields: [categoriaId], references: [id])
  taller          Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  ventaItems      VentaItem[]
  compraItems     CompraItem[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("productos")
}

model Pieza {
  id              String   @id @default(cuid())
  sku             String
  codigoBarras    String   @unique
  nombre          String
  descripcion     String?
  costoUnitario   Float
  precioVenta     Float
  stock           Int      @default(0)
  stockMinimo     Int      @default(5)
  garantiaFabricaDias Int?
  categoriaId     String?
  tallerId        String
  activo          Boolean  @default(true)
  operatorPaymentType  String?
  operatorPaymentValue Float?
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  categoria       Categoria? @relation(fields: [categoriaId], references: [id])
  taller          Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  servicioItems   ServicioItemPieza[]
  compraItems     CompraItem[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("piezas")
}

// ============ VENTAS (POS) ============

model Venta {
  id            String   @id @default(cuid())
  folio         String   @unique
  tallerId      String
  clienteId     String
  vendedorId    String
  operarioId    String?
  subtotal      Float
  total         Float
  metodoPago    String   @default("Efectivo")
  estado        EstadoVenta @default(COMPLETADA)
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  taller        Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  vendedor      Usuario  @relation(fields: [vendedorId], references: [id])
  operario      Operario? @relation(fields: [operarioId], references: [id])
  items         VentaItem[]
  garantia      Garantia?
  movimientos   Movimiento[]
  devoluciones  Devolucion[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("ventas")
}

model VentaItem {
  id          String   @id @default(cuid())
  ventaId     String
  productoId  String
  cantidad    Int
  precioUnitario Float
  subtotal    Float
  venta       Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [productoId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("venta_items")
}

// ============ SERVICIOS ============

model Servicio {
  id              String   @id @default(cuid())
  folio           String   @unique
  tallerId        String
  clienteId       String
  operarioId      String
  tipo            TipoServicio
  marca           String
  modelo          String
  imei            String?
  problemaReportado String
  diagnostico     String?
  descripcionServicio String
  estado          EstadoServicio @default(COMPLETADO)
  precioManoObra  Float
  subtotalPiezas  Float
  total           Float
  metodoPago      String   @default("Efectivo")
  pagado          Boolean  @default(false)
  notas           String?
  fechaEntrega    DateTime?
  garantiaDias    Int      @default(90)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  taller          Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  operario        Operario @relation(fields: [operarioId], references: [id])
  piezasUtilizadas ServicioItemPieza[]
  garantia        Garantia?
  movimientos     Movimiento[]
  devoluciones   Devolucion[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("servicios")
}

model ServicioItemPieza {
  id            String   @id @default(cuid())
  servicioId    String
  piezaId       String
  cantidad      Int
  costoUnitario Float
  precioVenta   Float
  subtotal      Float
  servicio      Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  pieza         Pieza    @relation(fields: [piezaId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("servicio_item_piezas")
}

// ============ GARANTÍAS ============

model Garantia {
  id              String   @id @default(cuid())
  folio           String   @unique
  tallerId        String
  clienteId       String
  ventaId         String?  @unique
  servicioId      String?  @unique
  tipo            TipoGarantia
  fechaInicio     DateTime
  duracionDias    Int
  fechaVencimiento DateTime
  descripcionCobertura String?
  estado          EstadoGarantia @default(ACTIVA)
  emitidaPorId    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  taller          Taller   @relation(fields: [tallerId], references: [id])
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  venta           Venta?   @relation(fields: [ventaId], references: [id])
  servicio        Servicio? @relation(fields: [servicioId], references: [id])
  usuario         Usuario   @relation(fields: [emitidaPorId], references: [id])
  reclamaciones   ReclamacionGarantia[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("garantias")
}

model ReclamacionGarantia {
  id          String   @id @default(cuid())
  garantiaId  String
  fecha       DateTime @default(now())
  descripcion String
  resolucion  ResolucionReclamacion
  motivoResolucion String?
  atendidaPorId String
  createdAt   DateTime @default(now())

  garantia    Garantia @relation(fields: [garantiaId], references: [id], onDelete: Cascade)

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("reclamaciones_garantia")
}

// ============ DEVOLUCIONES ============

model Devolucion {
  id              String   @id @default(cuid())
  folio           String   @unique
  tallerId        String
  tipo            TipoDevolucion
  ventaId         String?
  servicioId      String?
  productoId      String?
  piezaId         String?
  cantidad        Int
  motivo          String
  estado          EstadoDevolucion @default(PENDIENTE_REVISION)
  revisadaPorId   String?
  fechaRevision   DateTime?
  notasRevision   String?
  createdAt       DateTime @default(now())

  taller          Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  venta           Venta?   @relation(fields: [ventaId], references: [id])
  servicio        Servicio? @relation(fields: [servicioId], references: [id])
  revisadaPor     Usuario? @relation("RevisorDevolucion", fields: [revisadaPorId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("devoluciones")
}

// ============ MOVIMIENTOS / CAJA ============

model Movimiento {
  id          String   @id @default(cuid())
  tallerId    String
  tipo        TipoMovimiento
  concepto    String
  monto       Float
  categoria   String?
  usuarioId   String
  ventaId     String?
  servicioId  String?
  compraId    String?
  fecha       DateTime @default(now())
  notas       String?

  taller      Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  venta       Venta?   @relation(fields: [ventaId], references: [id])
  servicio    Servicio? @relation(fields: [servicioId], references: [id])
  compra      Compra?  @relation(fields: [compraId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("movimientos")
}

model Gasto {
  id          String   @id @default(cuid())
  tallerId    String
  concepto    String
  monto       Float
  categoria   String
  fecha       DateTime @default(now())
  notas       String?

  taller      Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@map("gastos")
}

// ============ COMPRAS ============

model Compra {
  id          String   @id @default(cuid())
  folio       String   @unique
  tallerId    String
  proveedor   String?
  total       Float
  fecha       DateTime @default(now())
  notas       String?

  taller      Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  items       CompraItem[]
  movimientos Movimiento[]

  @@map("compras")
}

model CompraItem {
  id          String   @id @default(cuid())
  compraId    String
  productoId  String?
  piezaId     String?
  cantidad    Int
  costoUnitario Float
  subtotal    Float
  compra      Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto    Producto? @relation(fields: [productoId], references: [id])
  pieza       Pieza?   @relation(fields: [piezaId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)

  @@map("compra_items")
}

// ============ PEDIDOS INTERNOS ============

model PedidoInterno {
  id          String   @id @default(cuid())
  folio       String   @unique
  tallerId    String
  solicitanteId String
  descripcion String
  cantidad    Int
  urgencia    UrgenciaPedido @default(MEDIA)
  estado      EstadoPedido @default(PENDIENTE)
  aprobadoPorId String?
  fechaAprobacion DateTime?
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taller      Taller   @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  solicitante Usuario  @relation(fields: [solicitanteId], references: [id])
  aprobadoPor Usuario? @relation("Aprobador", fields: [aprobadoPorId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("pedidos_internos")
}

// ============ COMISIONES Y PAGOS A OPERARIOS ============

model CommissionEntry {
  id             String   @id @default(cuid())
  operarioId     String
  tallerId       String
  ventaId        String?
  servicioId     String?
  ventaItemProductoId String?
  servicioItemPiezaId String?
  amount         Float
  type           TipoComisionEntry
  description    String
  estado         EstadoCommissionEntry @default(ACTIVE)
  operatorPaymentId String?
  createdAt      DateTime @default(now())

  operario       Operario  @relation(fields: [operarioId], references: [id])
  taller         Taller    @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  operatorPayment OperatorPayment? @relation(fields: [operatorPaymentId], references: [id])

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("commission_entries")
}

model OperatorPayment {
  id          String   @id @default(cuid())
  folio       String   @unique
  operarioId  String
  tallerId    String
  amount      Float
  date        DateTime
  paidAt      DateTime?
  paidById    String?
  status      EstadoOperatorPayment @default(PENDING)
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operario       Operario  @relation(fields: [operarioId], references: [id])
  taller         Taller    @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  commissionEntries CommissionEntry[]

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("operator_payments")
}

// ============ CONFIGURACIÓN GLOBAL ============

model ConfiguracionGlobal {
  id              String   @id @default(cuid())
  moneda          String   @default("USD")
  formatoTicket   String?
  datosFiscalesEmpresa String?
  pais            String   @default("Cuba")
  tipoCambio      Float    @default(650)
  serverUrl       String?
  ultimoSync      DateTime?
  syncEnabled     Boolean  @default(false)
  syncInterval    Int      @default(5)
  adminPaymentType String?
  adminPaymentValue Float?
  vendedorCommissionType String? @default("PERCENTAGE")
  vendedorCommissionValue Float? @default(1.5)
  updatedAt       DateTime @updatedAt

  // —— Sync fields (added by Phase 2) ——
  syncedAt       DateTime?
  syncVersion    Int        @default(0)
  deletedAt      DateTime?

  @@map("configuracion_global")
}

// ============ SINCRONIZACIÓN ============

model ChangeLog {
  id          String   @id @default(cuid())
  tabla       String
  registroId  String
  accion      String
  datos       String
  fecha       DateTime @default(now())
  usuarioId   String?
  sincronizado Boolean @default(false)

  @@index([tabla, fecha])
  @@index([sincronizado])
  @@map("change_log")
}


// ============================================================
// PHASE 2: Sync queue + state (local-only, no cloud counterpart)
// ============================================================

model SyncQueue {
  id          String   @id @default(cuid())
  tableName   String   // "venta", "producto", etc.
  recordId    String   // ID del registro afectado
  operation   String   // "INSERT" | "UPDATE" | "DELETE"
  payload     String   // JSON con los datos del registro
  createdAt   DateTime @default(now())
  attempts    Int      @default(0)
  lastError   String?
  priority    Int      @default(0)  // 0 = normal, 1 = alta (admin edits)

  @@index([createdAt])
  @@map("sync_queue")
}

model SyncState {
  id              String   @id @default("default")
  workshopId      String?  // ID del taller en el cloud (seteado en bootstrap)
  apiToken        String?  // JWT del taller (persistente entre reinicios)
  serverUrl       String?  // URL del Cloud API (ej: https://xxx.up.railway.app)
  syncEnabled     Boolean  @default(false)
  syncIntervalSec Int     @default(30)
  lastPullAt      DateTime?
  lastPushAt      DateTime?
  lastPullCursor  String?  // cloudVersion del ultimo evento bajado
  lastError       String?
  updatedAt       DateTime @updatedAt

  @@map("sync_state")
}
